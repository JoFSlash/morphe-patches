{
  "name": "Google Health",
  "workflow": "emulator-google-health.yml",
  "patches": "patches/src/main/kotlin/app/jofslash/patches/googlehealth",
  "extension": "extensions/googlehealth",
  "docs": "docs/google-health/README.md",
  "readme": {
    "style": "generated",
    "order": [
      "Privacy",
      "App"
    ],
    "intro": {
      "Privacy": "On by default. They change nothing you see.",
      "App": "Signing in, prompts and how the app behaves."
    }
  },
  "store": "https://play.google.com/store/apps/details?id=com.fitbit.FitbitMobile",
  "package": "com.fitbit.FitbitMobile",
  "store_note": "(Fitbit)",
  "summary": "Sign in through MicroG-RE instead of Google Play services, no surveys or nags, a black theme, screenshots on every screen, and a clone next to the official app.",
  "apk": {
    "release": "google-health",
    "version": "newest",
    "asset": "*.apkm",
    "file": "google-health.apkm"
  },
  "android": {
    "note": "Google Health needs Android 12L or newer: every version from there, and the next one, whose image is only in the SDK's canary channel so far. The release tries the oldest supported version, the newest stable one and the next one; a pull request the oldest and the newest stable.",
    "pull_request": [
      {
        "api": "32",
        "android": "12L",
        "channel": "stable"
      },
      {
        "api": "36",
        "android": "16",
        "channel": "stable",
        "verify": true
      }
    ],
    "full": [
      {
        "api": "32",
        "android": "12L",
        "channel": "stable"
      },
      {
        "api": "36",
        "android": "16",
        "channel": "stable",
        "verify": true
      },
      {
        "api": "37.0",
        "android": "17",
        "channel": "canary"
      }
    ]
  },
  "check": [
    "python3 .github/scripts/check_google_health.py \"$APK\" --cli \"$CLI\" --install --expect-welcome --compare-original --adb adb ${DEXDUMP:+--dexdump \"$DEXDUMP\"}",
    "python3 .github/scripts/check_google_health.py \"$APK\" --cli \"$CLI\" --install --expect-welcome --clone --adb adb"
  ],
  "test_inputs": [
    ".github/scripts/verify_google_health.py"
  ]
}
